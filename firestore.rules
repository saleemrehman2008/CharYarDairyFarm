rules_version = '2';

// Char Yar Dairy Farm.
//
// Roles live on users/{uid}.role: master | investor (co-founder) | customer.
// The farm ledger is staff-only; customers can reach the shop, their own
// orders and their own udhaar account and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isMaster() {
      return hasProfile() && me().role == 'master' && me().status != 'blocked';
    }

    // Master and co-founders run the farm side. A co-founder must be approved.
    function isStaff() {
      return isMaster() ||
        (hasProfile() && me().role == 'investor' && me().status == 'active');
    }

    // Customers must be approved before they can order.
    function isActiveCustomer() {
      return hasProfile() && me().status == 'active';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Emails the master listed on settings/farm take the co-founder role on
    // their own first sign-in, instead of waiting to be approved by hand.
    //
    // Only staff can write that list, and Google vouches for the address, so
    // this cannot be used to grant yourself anything the master did not
    // already intend.
    function autoCofounder() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/settings/farm).data
             .get('autoCofounderEmails', []);
    }

    function becomesCofounder() {
      return request.resource.data.role == 'investor'
        && request.resource.data.status == 'active';
    }

    // ---- Users ----
    // Own document is readable and created on first sign-in as a pending
    // customer; only the master may change a role or status.
    match /users/{uid} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == uid);

      // A customer needs no approval to browse, order or ask for udhaar — the
      // order and the udhaar account are each approved on their own. Anything
      // above customer still has to be granted.
      // `pending` is still accepted so a phone on an older build can sign up;
      // it is activated on the next sign-in by the rule below.
      allow create: if signedIn()
        && request.auth.uid == uid
        && ((request.resource.data.role == 'customer'
             && request.resource.data.status in ['active', 'pending'])
            || (autoCofounder() && becomesCofounder()));

      allow update: if isMaster()
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['name', 'email', 'photoUrl',
                                      'fcmTokens']))
        // Customers left waiting from before are activated on next sign-in.
        // A blocked account cannot let itself back in.
        || (signedIn() && request.auth.uid == uid
            && resource.data.role == 'customer'
            && resource.data.status == 'pending'
            && request.resource.data.role == 'customer'
            && request.resource.data.status == 'active'
            && changedKeys().hasOnly(['name', 'email', 'photoUrl', 'fcmTokens',
                                      'status']))
        // A listed co-founder who first signed in as a customer is upgraded on
        // their next sign-in. Blocked accounts stay blocked.
        || (signedIn() && request.auth.uid == uid
            && autoCofounder()
            && becomesCofounder()
            && resource.data.status != 'blocked'
            && resource.data.role != 'master'
            && changedKeys().hasOnly(['name', 'email', 'photoUrl', 'fcmTokens',
                                      'role', 'status', 'partnerId']));

      allow delete: if false;
    }

    // ---- Partners (capital and share ratios) ----
    match /partners/{id} {
      allow read: if isStaff();

      // A co-founder may open their own record, but only an empty one — every
      // rupee of capital is still the master's to enter.
      allow create: if isMaster()
        || (isStaff()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.invested == 0
            && request.resource.data.reinvested == 0
            && request.resource.data.withdrawn == 0);

      allow update, delete: if isMaster();
    }

    // ---- Products (the shop catalogue) ----
    match /products/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- The ledger ----
    // Entries are never hard-deleted; the master sets deletedAt instead, so the
    // row survives in the Google Sheet marked deleted.
    match /transactions/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // ---- Orders ----
    // A customer raises their own order and cannot touch it afterwards; only
    // staff approve it and move it along.
    match /orders/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isStaff()
        || (isActiveCustomer()
            && request.resource.data.customerId == request.auth.uid
            && request.resource.data.status == 'new'
            && !('approvedBy' in request.resource.data));

      allow update: if isStaff();
      allow delete: if false;
    }

    // ---- Standing daily orders ----
    match /subscriptions/{id} {
      allow read, update, delete: if isStaff()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isStaff()
        || (isActiveCustomer()
            && request.resource.data.customerId == request.auth.uid);
    }

    // ---- Udhaar accounts ----
    // The customer registers; staff set the limit, approve, and move the
    // balance. A customer can never approve themselves.
    match /udhaar_accounts/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);

      allow create: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.balance == 0);

      allow update: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == 'pending'
            && !changedKeys().hasAny(['limit', 'balance', 'approvedBy',
                                      'approvedByName', 'approvedAt']));

      allow delete: if false;
    }

    // ---- Farm months and closes ----
    match /months/{id} {
      allow read: if isStaff();
      allow write: if isMaster();
    }

    // ---- Settings ----
    // Everyone signed in reads the bank details and the milk rate. Placing an
    // order bumps the order counter, which is the one field a customer writes.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
      allow update: if isActiveCustomer() && changedKeys().hasOnly(['orderSeq']);
      allow create: if isActiveCustomer()
        && request.resource.data.keys().hasOnly(['orderSeq']);
    }

    // ---- Activity log ----
    // Anyone signed in appends (their own sign-in is the first line); only the
    // master reads it, and nothing is ever edited.
    match /logs/{id} {
      allow read: if isMaster();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
