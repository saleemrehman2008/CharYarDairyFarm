rules_version = '2';

// Char Yar Dairy Farm.
//
// Roles live on users/{uid}.role:
//   master    — everything
//   investor  — co-founder: the books, approvals, the round
//   silent    — silent investor: reads the books, writes nothing at all
//   staff     — delivery: the round, orders to drop off, money collected
//   customer  — the shop, their own orders, their own khaata
//
// The ledger is readable only by the partners. Delivery staff can write the
// money they take in but never read it back, and a customer sees nothing but
// their own.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isMaster() {
      return hasProfile() && me().role == 'master' && me().status != 'blocked';
    }

    // The partners run the farm side. A co-founder must be approved.
    //
    // This is the write test. Everything that changes a figure asks this
    // one, and a silent investor fails it — which is the whole of what
    // makes him silent. Taking the buttons off his screen is a courtesy;
    // this is the guarantee.
    function isPartner() {
      return isMaster() ||
        (hasProfile() && me().role == 'investor' && me().status == 'active');
    }

    // And this is the read test: everybody whose money is in the farm.
    //
    // A silent investor has put capital in and takes his share like the
    // rest of them. The books are open to the people whose money is in
    // them — he can see every rupee and move none of it, which is also
    // why he can never be suspected of having moved one.
    function canSee() {
      return isPartner() ||
        (hasProfile() && me().role == 'silent' && me().status == 'active');
    }

    // Which partner record belongs to the person asking. Written onto the
    // user document when the partner is created, so the answer costs the one
    // read the rules already make.
    function myPartnerId() {
      return me().get('partnerId', 'none');
    }

    // Whoever keeps the farm's cash answers for its own account. The farm
    // account is not a person and has no hands to confirm with, so without
    // somebody named here a man's own word would be enough to move his own
    // holding down — which is the one thing these books are built to stop.
    function keepsTheCash() {
      return isPartner() && myPartnerId() != 'none'
        && get(/databases/$(database)/documents/partners/$(myPartnerId()))
             .data.get('keepsCash', false) == true;
    }

    // Delivery staff walk the round and take money at the door. They can read
    // none of the farm's books: every rule below spells out the little they
    // touch, and their phone never even asks for the rest.
    function isDelivery() {
      return hasProfile() && me().role == 'staff' && me().status == 'active';
    }

    function onTheRound() {
      return isPartner() || isDelivery();
    }

    // The same list, for reading only. A silent investor watches the round
    // like everything else: the orders, the deliveries, the day's takings.
    // He is not on it and never writes a line of it.
    function canSeeRound() {
      return canSee() || isDelivery();
    }

    // Customers must be approved before they can order.
    function isActiveCustomer() {
      return hasProfile() && me().status == 'active';
    }

    // Whether a period is still being written. A month document that does
    // not exist yet is open: the first entry of a period is written before
    // anything opens it.
    // Money landing on an entry that was booked on credit. Not a change to
    // what the entry says, so it is not held to the open-period rule.
    function settlingOnly() {
      return isPartner()
        && changedKeys().hasOnly(['paid', 'paidSoFar', 'paidAt', 'payVia',
                                  'handledBy']);
    }
    // The new date of an entry lands inside the period it is booked into,
    // and not in the future.
    //
    // A day's slack at each end, deliberately. The period's `from` is the
    // moment the first entry was written rather than midnight — an entry on
    // the morning of that same day is inside the period and would fail a
    // strict comparison. And the far end is a phone's own clock, which can
    // be a few minutes ahead of the server's. Neither slack reaches another
    // period's figures, which is what this is guarding.
    function datedInside(id) {
      return request.resource.data.date <= request.time + duration.value(1, 'd')
        && (!exists(/databases/$(database)/documents/months/$(id))
            || !('from' in get(/databases/$(database)/documents/months/$(id)).data)
            || request.resource.data.date >=
               get(/databases/$(database)/documents/months/$(id)).data.from
               - duration.value(1, 'd'));
    }
    function openPeriod(id) {
      return !exists(/databases/$(database)/documents/months/$(id))
        || get(/databases/$(database)/documents/months/$(id)).data.get('status', 'open') == 'open';
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Emails the master set aside on settings/farm take their role on their own
    // first sign-in, instead of waiting to be granted by hand.
    //
    // Only the partners can write those lists, and Google vouches for the
    // address, so this cannot be used to take anything the master did not
    // already set aside.
    function listedOn(field) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/settings/farm).data
             .get(field, []);
    }

    /// The role this email was set aside for, if the account is claiming one.
    function claimsListedRole() {
      return (listedOn('autoCofounderEmails')
              && request.resource.data.role == 'investor')
        || (listedOn('staffEmails')
            && request.resource.data.role == 'staff');
    }

    function becomesListed() {
      return claimsListedRole()
        && request.resource.data.status == 'active';
    }

    // ---- Users ----
    // Own document is readable and created on first sign-in as a pending
    // customer; only the master may change a role or status.
    match /users/{uid} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == uid);

      // A customer needs no approval to browse, order or ask for udhaar — the
      // order and the udhaar account are each approved on their own. Anything
      // above customer still has to be granted.
      // `pending` is still accepted so a phone on an older build can sign up;
      // it is activated on the next sign-in by the rule below.
      allow create: if signedIn()
        && request.auth.uid == uid
        && ((request.resource.data.role == 'customer'
             && request.resource.data.status in ['active', 'pending'])
            || becomesListed());

      allow update: if isMaster()
        // Own profile and delivery details. A role or status is not in here.
        // Own profile and delivery details, plus the two things that change
        // only what this phone shows — and `asFarm`, which is the hat the
        // man keeping the farm's cash is wearing while he runs its account.
        // It is his to set because it grants him nothing: every figure it
        // touches he could already type the farm account's name into by
        // hand, and the rules on the money ask what the entry says, never
        // what hat was on when it was typed.
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['name', 'email', 'photoUrl',
                                      'fcmTokens', 'address', 'mobile',
                                      'lang', 'skin', 'asFarm',
                                      'chatSeenAt']))
        // The pointer to their own capital record, written on first sign-in.
        // It has to be right: the rules on months read it to decide whose
        // share this person may answer for, so it is only accepted when the
        // record it points at names them back.
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['partnerId'])
            && get(/databases/$(database)/documents/partners/$(request.resource.data.partnerId)).data.userId == request.auth.uid)
        // Customers left waiting from before are activated on next sign-in.
        // A blocked account cannot let itself back in.
        || (signedIn() && request.auth.uid == uid
            && resource.data.role == 'customer'
            && resource.data.status == 'pending'
            && request.resource.data.role == 'customer'
            && request.resource.data.status == 'active'
            && changedKeys().hasOnly(['name', 'email', 'photoUrl', 'fcmTokens',
                                      'status']))
        // Someone on a list who first signed in as a customer is moved across
        // on their next sign-in. Blocked accounts stay blocked.
        || (signedIn() && request.auth.uid == uid
            && becomesListed()
            && resource.data.status != 'blocked'
            && resource.data.role != 'master'
            && changedKeys().hasOnly(['name', 'email', 'photoUrl', 'fcmTokens',
                                      'role', 'status', 'partnerId']));

      allow delete: if false;
    }

    // ---- Partners (capital and share ratios) ----
    // The men the farm pays a wage to. Not users of the app and never
    // deleted once a wage has been paid against them — a figure in a closed
    // month whose name has gone is worth nothing to anybody.
    match /employees/{id} {
      allow read: if canSee();
      allow create, update: if isPartner()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.basic >= 0
        && request.resource.data.allowance >= 0;
      allow delete: if isMaster();
    }

    match /partners/{id} {
      allow read: if canSee();

      // A co-founder may open their own record, but only an empty one — every
      // rupee of capital is still the master's to enter.
      allow create: if isMaster()
        || (isPartner()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.invested == 0
            && request.resource.data.reinvested == 0
            && request.resource.data.withdrawn == 0);

      // Their own sign-in refreshes the name and email on their own record —
      // which is how two accounts belonging to the same person are told apart
      // on screen. Every figure in the record stays the master's alone.
      //
      // It may also claim a record the master opened for them before they had
      // ever signed in: unclaimed, and carrying their own email. That is the
      // whole test — a record with somebody else's email, or one already
      // claimed, cannot be taken.
      allow update: if isMaster()
        || (canSee()
            && resource.data.userId == request.auth.uid
            && changedKeys().hasOnly(['name', 'email']))
        || (canSee()
            && resource.data.get('userId', '') == ''
            && resource.data.get('email', '') == me().email
            && request.resource.data.userId == request.auth.uid
            && changedKeys().hasOnly(['userId', 'name', 'email']));

      allow delete: if isMaster();
    }

    // ---- The four of them funding the farm ----
    //
    // One line for every rupee of a co-founder's own money going in: what
    // day, whose, how much, and whether it was handed over or spent
    // straight on something the farm bought.
    //
    // Writing one moves the capital on a partner record, and capital has
    // always been the master's alone to enter, so these are too. All four
    // read them — the whole purpose of keeping them is that none of these
    // four has to take any other's word for what he has put in.
    match /contributions/{id} {
      allow read: if canSee();
      allow create, update: if isMaster();
      // Taken out by marking it deleted, the same as a ledger entry, so
      // the line survives in the Sheet instead of vanishing from both.
      allow delete: if false;
    }

    // ---- Cash passing between two pairs of hands ----
    //
    // Anybody who keeps the books may write one: the man handing the money
    // over is usually the one holding the phone. Only the man it was sent
    // to may answer it, and that is the whole point of the record — one
    // word is not enough for both halves of it.
    //
    // The server cannot tell which partner is which by name, so what it
    // enforces is the shape: a partner may update one of these, and may not
    // move the money, the names, or who sent it. Who may answer is enforced
    // by the app, and every answer carries the name of whoever gave it.
    match /transfers/{id} {
      allow read: if canSee();
      allow create: if isPartner()
        && request.resource.data.state == 'waiting'
        && request.resource.data.amount > 0;

      // Answered, never rewritten: what was handed over, to whom and for
      // how much is fixed the moment it is sent, and so are the entries it
      // was made of. Money paid into the farm's own account is answered for
      // by whoever keeps the cash, or by the master — and never by the man
      // who sent it, or the second word is the first one over again.
      allow update: if isPartner()
        && resource.data.state == 'waiting'
        && !changedKeys().hasAny(['from', 'to', 'amount', 'sentBy',
                                 'sentAt', 'payVia', 'txnIds'])
        && (resource.data.to != 'Farm account'
            || ((isMaster() || keepsTheCash())
                && resource.data.from != me().name));
      // Taken back by whoever sent it, and only while nobody has answered.
      allow delete: if isPartner() && resource.data.state == 'waiting';
    }
    // ---- Money the farm has lent its own ----
    //
    // A co-founder asks for their own, and only for themselves. Handing it
    // over is the master's alone, because that is real money leaving the farm
    // and money leaving the farm has never been anybody else's to do — the
    // asking and the giving are two halves, written down separately with
    // whose finger pressed each.
    //
    // Nothing is deleted. A request that was turned down stays on the record:
    // four friends should be able to look back at what was asked and what was
    // said, and a record that only keeps the answers somebody liked is not a
    // record.
    match /founder_loans/{id} {
      allow read: if canSee();

      allow create: if isMaster()
        || (isPartner()
            && request.resource.data.partnerId == myPartnerId()
            && request.resource.data.state == 'asked');

      allow update: if isMaster();

      // The master may take an arrangement off the list. It is only the
      // arrangement: the cash that actually moved lives in transactions and
      // is removed there, like every other rupee.
      allow delete: if isMaster();
    }

    // ---- The farm's room ----
    //
    // Only the people who run the farm are in it: a customer or a rider can
    // neither read it nor write to it.
    //
    // Nothing said can be changed or removed afterwards, by anybody, the
    // master included. That is the whole reason the room exists rather than
    // a WhatsApp group — four people keeping books together have to be able
    // to point at what was said about a figure and know it is what was said.
    // A line is also stamped with who wrote it by the server's reckoning of
    // who is signed in, so nobody can post under another founder's name.
    match /chat/{id} {
      allow read: if canSee();

      allow create: if isPartner()
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.at == request.time;

      allow update, delete: if false;
    }

    // ---- Products (the shop catalogue) ----
    match /products/{id} {
      allow read: if signedIn();
      allow write: if isPartner();
    }

    // ---- The cattle register ----
    //
    // The herd is an asset of the farm and its history is a record of money
    // spent, so it belongs to the four of them and nobody else. Staff on the
    // round and customers cannot see it at all.
    match /animals/{id} {
      allow read: if canSee();
      allow write: if isPartner();
    }

    // Full-size animal pictures, kept here rather than in Firebase Storage —
    // Storage needs a card on a billing account, and a shrunk photo costs the
    // free tier almost nothing.
    // Receipts on ledger entries — a bank slip, a chit from the mandi.
    // Kept apart from the entry so a page of the ledger never carries them.
    match /txn_photos/{id} {
      allow read: if canSee();
      allow write: if isPartner();
    }
    match /animal_photos/{id} {
      allow read: if canSee();
      allow write: if isPartner();
    }

    match /animal_events/{id} {
      allow read: if canSee();
      allow create: if isPartner();
      allow update: if isPartner();
      // History is not rewritten; a mistake is corrected with another line.
      allow delete: if isMaster();
    }

    // ---- The ledger ----
    // Entries are never hard-deleted; the master sets deletedAt instead, so the
    // row survives in the Google Sheet marked deleted.
    match /transactions/{id} {
      allow read: if canSee();

      // Delivery staff may write the money they took in — a sale at the door
      // or a receipt against a khaata — and nothing else. They cannot read the
      // ledger back, so a delivery phone can never show the farm's books.
      // A new entry may be dated back inside the period it is booked into —
      // the milk nobody wrote down on Tuesday — and no further. Reaching
      // past that is the master's, the same as moving an existing entry.
      allow create: if (isPartner()
            && (isMaster() || datedInside(request.resource.data.monthId)))
        || (isDelivery()
            && request.resource.data.type in ['sale', 'receipt']);

      // Correcting an entry.
      //
      // `monthId` never moves, for anybody including the master. It is the
      // field every closed month's frozen figures were worked out from, and
      // an entry that could walk between periods could take profit out of
      // one that has already been shared between four people.
      //
      // A correction may only be made while the entry's period is still
      // open. Those months are settled on the day and the co-founders are
      // paid out of them; a correction to a settled one is a fresh entry in
      // the open period, which is what a book of accounts has always done.
      //
      // Settling is not a correction and is allowed whenever. A September
      // sale on credit is paid in October, and the money lands on the
      // September row — the period being closed is exactly when this
      // happens, so a rule that stopped it would stop the farm collecting.
      //
      // The date may move inside the period and no further. Anybody who
      // keeps the books can put an entry on the right day of the period
      // being written — that is where the mistakes are. Taking it out of
      // that period is the master's, because an earlier day has been read,
      // agreed and printed on somebody's statement. Nothing is dated
      // forward of today either way. Marking an entry deleted rewrites what
      // the farm earned, so that stays the master's.
      allow update: if !changedKeys().hasAny(['monthId'])
        && (settlingOnly()
            || (openPeriod(resource.data.monthId)
                && (isMaster()
                    || (isPartner()
                        && !changedKeys().hasAny(['deletedAt'])
                        && (!changedKeys().hasAny(['date'])
                            || datedInside(resource.data.monthId)))))
            || (isMaster() && changedKeys().hasOnly(['deletedAt'])));

      allow delete: if false;
    }

    // ---- Orders ----
    // A customer raises their own order and cannot touch it afterwards; only
    // staff approve it and move it along.
    match /orders/{id} {
      allow read: if canSeeRound()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isPartner()
        || (isActiveCustomer()
            && request.resource.data.customerId == request.auth.uid
            && request.resource.data.status == 'new'
            && !('approvedBy' in request.resource.data));

      // The rider marks the days delivered; a partner approves the order and
      // nothing more. Delivering is not a co-founder's button — see the
      // deliveries rule above for why.
      allow update: if isMaster()
        || (isPartner()
            && !changedKeys().hasAny(['doneDays', 'deliveredAt']))
        || (isDelivery()
            && changedKeys().hasOnly(['status', 'deliveredAt', 'doneDays']))
        // A customer may call off their own order while the farm has not
        // started on it — nothing else about it, and never once approved.
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'new'
            && !('approvedAt' in resource.data)
            && request.resource.data.status == 'cancelled'
            && changedKeys().hasOnly(['status']));

      allow delete: if false;
    }

    // ---- Standing daily orders ----
    match /subscriptions/{id} {
      allow read, update, delete: if isPartner()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isPartner()
        || (isActiveCustomer()
            && request.resource.data.customerId == request.auth.uid);
    }

    // ---- Udhaar accounts ----
    // The customer registers; staff set the limit, approve, and move the
    // balance. A customer can never approve themselves.
    match /udhaar_accounts/{uid} {
      allow read: if canSeeRound() || (signedIn() && request.auth.uid == uid);

      allow create: if isPartner()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.balance == 0);

      allow update: if isPartner()
        // Delivering milk and taking money move the balance; the rate, the
        // limit and the approval stay the master's.
        || (isDelivery() && changedKeys().hasOnly(['balance', 'billedAt']))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == 'pending'
            && !changedKeys().hasAny(['limit', 'balance', 'approvedBy',
                                      'approvedByName', 'approvedAt']));

      allow delete: if false;
    }

    // ---- The daily milk round ----
    // Staff write it; the customer may read their own days so they can check
    // the bill against what they actually took.
    // Milk is marked delivered by the person who actually handed it over.
    // A co-founder tapping it by mistake would put milk on a bill that never
    // left the van, so the button is gone from their app and refused here.
    // The master can still correct a mistake — somebody has to be able to.
    match /deliveries/{id} {
      allow read: if canSeeRound()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isDelivery() || isMaster();
      allow delete: if isDelivery() || isMaster();

      allow update: if isDelivery() || isMaster()
        // A partner may stamp a day as billed, and nothing else about it.
        || (isPartner() && changedKeys().hasOnly(['billId', 'billed']));
    }

    // A rider's day: what milk went out with him, what came back, and the
    // cash he is holding until a founder takes it in.
    match /rider_days/{id} {
      allow read: if canSeeRound();

      // His own day, and only his own.
      allow create: if isDelivery()
        && request.resource.data.riderId == request.auth.uid;

      allow update: if isMaster()
        // The rider adds to his own tally and hands it over.
        || (isDelivery() && resource.data.riderId == request.auth.uid
            && !changedKeys().hasAny(['receivedBy', 'receivedByName',
                                      'receivedAt', 'receivedCash',
                                      'receivedLitres']))
        // A founder counts it and takes it in. Nothing else about the day is
        // theirs to touch — the tally is the round's own record.
        || (isPartner() && changedKeys().hasOnly(['receivedBy',
                                                  'receivedByName',
                                                  'receivedAt', 'receivedCash',
                                                  'receivedLitres', 'status']));

      allow delete: if isMaster();
    }

    // ---- Khaata bills ----
    // Only the farm raises a bill or records a payment. A customer can read
    // their own, and nothing more.
    match /bills/{id} {
      allow read: if canSeeRound()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      // A partner raises a bill. The delivery man raises one too, but only the
      // month-end bill his own last delivery of the month triggers — and never
      // one with money already marked against it.
      allow create: if isPartner()
        || (isDelivery() && request.resource.data.paid == 0);
      allow update: if isPartner()
        || (isDelivery() && changedKeys().hasOnly(
              ['paid', 'settledAt', 'litres', 'thisMonth', 'billedAt']));
      allow delete: if isMaster();
    }

    // ---- Farm months and closes ----
    // A period of trading. The master opens, seals and closes it; the figures
    // written at the seal are his and nobody else may touch them.
    //
    // The one exception is each co-founder saying they have seen a closed
    // period's figures. It is not a decision and it holds nothing up — the
    // master closes when he closes. It is the record that all four were shown
    // what the month came to, which four friends in business need written
    // down more than they need a veto.
    //
    // `seen` is a map keyed by partner id, so the diff below can insist that
    // a co-founder's write touches nothing but their own key. The database
    // enforces it, not the app.
    match /months/{id} {
      allow read: if canSee();
      allow create, delete: if isMaster();

      // Saying you have read your own share is not a change to the books,
      // so it is canSee() and not isPartner(): a silent investor has a
      // slice like the rest of them and must be able to say he has seen it,
      // or the notice sits on his home page for ever and the button under
      // it fails every time he presses it. He is still held to his own key
      // by the last clause — he may mark his own slot and nobody else's,
      // and not one figure in the period moves either way.
      allow update: if isMaster()
        || (canSee()
            && resource.data.status == 'closed'
            && changedKeys().hasOnly(['seen'])
            && request.resource.data.get('seen', {})
                 .diff(resource.data.get('seen', {}))
                 .affectedKeys()
                 .hasOnly([myPartnerId()]));
    }

    // ---- Settings ----
    // Everyone signed in reads the bank details and the milk rate. Placing an
    // order bumps the order counter, which is the one field a customer writes.
    // Which parts of the farm are running is the master's decision alone, so
    // a co-founder may write everything here except that.
    match /settings/{doc} {
      allow read: if signedIn();
      allow delete: if isMaster();
      allow update: if isMaster()
        || (isPartner() && !changedKeys().hasAny(['features']))
        || (isActiveCustomer() && changedKeys().hasOnly(['orderSeq']));
      allow create: if isPartner()
        || (isActiveCustomer()
            && request.resource.data.keys().hasOnly(['orderSeq']));
    }

    // ---- Activity log ----
    // Anyone signed in appends to it — their own sign-in is the first line —
    // and every partner can read it. Four friends are in business together,
    // and a record only one of them can see is not a record: it is that one
    // person's word. Nobody, the master included, can change or remove a
    // line once it is written.
    match /logs/{id} {
      allow read: if canSee();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
